# NekoOS arm64 (aarch64 phones/tablets: Android-bootloader and UEFI devices, arm64 desktops)
CONFIG_ARM64=y
CONFIG_COMPAT=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_EXYNOS=y
CONFIG_ARCH_ROCKCHIP=y
# Pixel 6+ (Tensor gs101) lives under ARCH_EXYNOS upstream
CONFIG_DRM_MSM=m
CONFIG_DRM_PANFROST=m
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_LIMA=m
CONFIG_ACPI=y
CONFIG_OF=y

# Boot: EFI zboot (UEFI phones/SBCs); empty CONFIG_CMDLINE means the bootloader cmdline is used
CONFIG_EFI_ZBOOT=y
