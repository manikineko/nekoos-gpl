# NekoOS x86_64 (Intel/AMD desktops, laptops, x86 tablets)
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_IA32_EMULATION=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_DRM_HYPERV=y
