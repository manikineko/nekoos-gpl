diff --git a/hw/arm/manikineko.c b/hw/arm/manikineko.c
new file mode 100644
index 0000000..4848967
--- /dev/null
+++ b/hw/arm/manikineko.c
@@ -0,0 +1,77 @@
+/*
+ * manikineko-arm: Phone_AArch64 profile AND the desktop's gated AArch64
+ * secondary (U6) — same machine, different launcher wiring.
+ *
+ * virt-based machine plus the Manikineko platform devices:
+ *   manikineko-ec   MMIO mailbox at 0x09042000 (free window below SMMU)
+ *   uxh1-slot x4    MMIO at 0x09043000 + n*0x100
+ *
+ * As phone primary: boots TF-A/U-Boot/UEFI from -bios/-kernel; requests
+ * the x64 assist via mailbox cmd 0x01.
+ * As desktop secondary: spawned by launch_manikineko.py after ec_sim
+ * reports SEC_ARM_PG; its -serial is the SEC_* IPC socket to the x64 side.
+ *
+ * EC backend: -chardev socket,id=ec-sim,... is bound automatically.
+ */
+#include "qemu/osdep.h"
+#include "hw/arm/virt.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "chardev/char.h"
+#include "qapi/error.h"
+
+#define MK_EC_BASE    0x09042000
+#define MK_UXH1_BASE  0x09043000
+#define MK_EC_CHR_ID  "ec-sim"
+
+static void mk_arm_add_platform_devices(MachineState *machine)
+{
+    Chardev *chr = qemu_chr_find(MK_EC_CHR_ID);   /* optional */
+    DeviceState *ec;
+
+    ec = qdev_new("manikineko-ec");
+    qdev_prop_set_uint8(ec, "profile", 1);         /* mobile by default */
+    if (chr) {
+        qdev_prop_set_chr(ec, "socket", chr);
+    }
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(ec), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(ec), 0, MK_EC_BASE);
+
+    for (int i = 0; i < 4; i++) {
+        DeviceState *d = qdev_new("uxh1-slot");
+        qdev_prop_set_uint8(d, "slot", i);
+        object_property_set_link(OBJECT(d), "ec", OBJECT(ec),
+                                 &error_abort);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(d), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(d), 0, MK_UXH1_BASE + i * 0x100);
+    }
+}
+
+static void manikineko_arm_machine_init(MachineState *machine)
+{
+    /* run the parent (virt) machine init, then bolt on our devices */
+    ObjectClass *parent = object_class_get_parent(object_get_class(OBJECT(machine)));
+    MachineClass *parent_mc = MACHINE_CLASS(parent);
+    parent_mc->init(machine);
+    mk_arm_add_platform_devices(machine);
+}
+
+static void manikineko_arm_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "Manikineko AArch64 profile (phone primary or"
+              " desktop secondary)";
+    mc->init = manikineko_arm_machine_init;
+    mc->max_cpus = 8;
+}
+
+static const TypeInfo manikineko_arm_type = {
+    .name = MACHINE_TYPE_NAME("manikineko-arm"),
+    .parent = TYPE_VIRT_MACHINE,
+    .class_init = manikineko_arm_class_init,
+};
+static void manikineko_arm_register(void)
+{
+    type_register_static(&manikineko_arm_type);
+}
+type_init(manikineko_arm_register)
