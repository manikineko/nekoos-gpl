diff --git a/hw/i386/manikineko.c b/hw/i386/manikineko.c
new file mode 100644
index 0000000..ef1d803
--- /dev/null
+++ b/hw/i386/manikineko.c
@@ -0,0 +1,80 @@
+/*
+ * manikineko-x64: Desktop_Intel profile.
+ *
+ * i440fx-based machine plus the Manikineko platform devices:
+ *   manikineko-ec   MMIO mailbox at 0xFEBF0000 (below IOAPIC/LAPIC window)
+ *   uxh1-slot x4    MMIO at 0xFEBE0000 + n*0x100
+ *
+ * The gated AArch64 secondary (U6) is NOT a CPU in this process; in the
+ * co-sim it is a sibling qemu-system-aarch64 -M manikineko-arm attached
+ * to the same ec_sim. SEC_* UART/IRQ IPC is a -serial socket pair the
+ * launcher wires between the two processes.
+ *
+ * EC backend: pass -chardev socket,id=ec-sim,... and the machine binds
+ * the named chardev to the EC device automatically.
+ */
+#include "qemu/osdep.h"
+#include "hw/i386/pc.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "chardev/char.h"
+#include "qapi/error.h"
+
+#define MK_EC_BASE    0xFEBF0000
+#define MK_UXH1_BASE  0xFEBE0000
+#define MK_EC_CHR_ID  "ec-sim"
+
+static void mk_x64_add_platform_devices(MachineState *machine)
+{
+    DeviceState *ec;
+    Chardev *chr = qemu_chr_find(MK_EC_CHR_ID);   /* optional */
+
+    ec = qdev_new("manikineko-ec");
+    qdev_prop_set_uint8(ec, "profile", 2);         /* desktop */
+    if (chr) {
+        qdev_prop_set_chr(ec, "socket", chr);
+    }
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(ec), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(ec), 0, MK_EC_BASE);
+
+    for (int i = 0; i < 4; i++) {
+        DeviceState *d = qdev_new("uxh1-slot");
+        qdev_prop_set_uint8(d, "slot", i);
+        object_property_set_link(OBJECT(d), "ec", OBJECT(ec),
+                                 &error_abort);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(d), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(d), 0, MK_UXH1_BASE + i * 0x100);
+    }
+}
+
+static void manikineko_x64_machine_init(MachineState *machine)
+{
+    /* run the parent (pc-i440fx) machine init, then bolt on our devices */
+    ObjectClass *parent = object_class_get_parent(object_get_class(OBJECT(machine)));
+    MachineClass *parent_mc = MACHINE_CLASS(parent);
+    parent_mc->init(machine);
+    mk_x64_add_platform_devices(machine);
+}
+
+static void manikineko_x64_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "Manikineko Desktop_Intel profile (x64 primary)";
+    mc->init = manikineko_x64_machine_init;
+    mc->max_cpus = 16;
+    mc->alias = NULL;                 /* do not inherit pc alias/default */
+    mc->is_default = false;
+    /* keep upstream pc options (firmware=bios-256k.bin etc.) from parent */
+}
+
+static const TypeInfo manikineko_x64_type = {
+    /* parent is the versioned i440fx type; bump on QEMU rebase */
+    .name = MACHINE_TYPE_NAME("manikineko-x64"),
+    .parent = MACHINE_TYPE_NAME("pc-i440fx-9.2"),
+    .class_init = manikineko_x64_class_init,
+};
+static void manikineko_x64_register(void)
+{
+    type_register_static(&manikineko_x64_type);
+}
+type_init(manikineko_x64_register)
