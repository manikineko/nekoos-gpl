diff --git a/include/hw/misc/manikineko.h b/include/hw/misc/manikineko.h
new file mode 100755
index 0000000..34424fc
--- /dev/null
+++ b/include/hw/misc/manikineko.h
@@ -0,0 +1,19 @@
+/*
+ * Manikineko platform device interface.
+ * Shared by the EC mailbox device and the UXH-1 expansion slots.
+ */
+#ifndef HW_MISC_MANIKINEKO_H
+#define HW_MISC_MANIKINEKO_H
+
+#include "hw/qdev-core.h"
+
+#define TYPE_MANIKINEKO_EC "manikineko-ec"
+
+/*
+ * Query an expansion slot's live status through the EC device.
+ * field: 0=present, 1=isa, 2=lanes_adv, 3=slot index.
+ * Returns 0 when the EC has no card in @slot.
+ */
+uint8_t mk_ec_card_status(DeviceState *ec_dev, int slot, int field);
+
+#endif
